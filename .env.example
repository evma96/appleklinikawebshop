PROJECT_NAME=appleklinikawebshop

WORDPRESS_VERSION=6.5.5
PHP_VERSION=8.2
MARIADB_VERSION=11.4
PHPMYADMIN_VERSION=5.2

WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

MYSQL_DATABASE=appleklinika
MYSQL_USER=appleklinika
MYSQL_PASSWORD=change-me-local-password
MYSQL_ROOT_PASSWORD=change-me-root-password

WORDPRESS_DEBUG=1
PHPMYADMIN_UPLOAD_LIMIT=128M

# Opt-in durable LOCAL recovery only; keep disabled for other environments.
# COMPOSE_PROJECT_NAME=appleklinikawebshop
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# With this overlay use WORDPRESS_PORT=127.0.0.1:8082.
LOCAL_WORDPRESS_URL=http://localhost:8082
LOCAL_WORDPRESS_VOLUME=appleklinikawebshop_wordpress_data
LOCAL_DATABASE_VOLUME=appleklinikawebshop_mariadb_data
LOCAL_LEGACY_WORDPRESS_PORT=127.0.0.1:8080

# Opt-in LOCAL reconciliation overlay (no provider traffic or outgoing mail).
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml:docker-compose.integration.yml
LOCAL_UPLOADS_PATH=./.local-runtime/storefront-uploads
LOCAL_RUNTIME_NETWORK=appleklinikawebshop_default

# Optional Google Business Profile read access; private JSON mounted outside webroot.
AK_GOOGLE_REVIEWS_CONFIG_FILE=

# LOCAL visual QA overlay only; never set on TEST/production. No real review data.
AK_GOOGLE_REVIEWS_QA_HOST_FILE=

# Optional LOCAL iPhone HEIC decoder (same WordPress/PHP; no TEST/production use).
# Append :docker-compose.local-media.yml to the existing LOCAL COMPOSE_FILE.

# Product photo metadata sanitizer; executable must be installed in the runtime.
AK_PHOTO_METADATA_TOOL=/usr/bin/exiftool

# Reproducible TEST-only media overlay; unused by the LOCAL compose selection.
AK_TEST_MEDIA_IMAGE=appleklinika-wordpress-test-media:7.0.2-php8.2
AK_TEST_REPO_ROOT=/opt/appleklinika/repo
AK_TEST_WORDPRESS_BASE_IMAGE=wordpress:7.0.2-php8.2-apache@sha256:680df6fd52a1ec7948deb6ca5fa57f1bca0d5d062396ffd0c57b8b4f24adc23f
