PROJECT_NAME=appleklinikawebshop

WORDPRESS_VERSION=6.5.5
PHP_VERSION=8.2
MARIADB_VERSION=11.4
PHPMYADMIN_VERSION=5.2

WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

MYSQL_DATABASE=appleklinika
MYSQL_USER=appleklinika
MYSQL_PASSWORD=change-me-local-password
MYSQL_ROOT_PASSWORD=change-me-root-password

WORDPRESS_DEBUG=1
PHPMYADMIN_UPLOAD_LIMIT=128M

# Opt-in durable LOCAL recovery only; keep disabled for other environments.
# COMPOSE_PROJECT_NAME=appleklinikawebshop
# COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
# With this overlay use WORDPRESS_PORT=127.0.0.1:8082.
LOCAL_WORDPRESS_URL=http://localhost:8082
LOCAL_WORDPRESS_VOLUME=appleklinikawebshop_wordpress_data
LOCAL_DATABASE_VOLUME=appleklinikawebshop_mariadb_data
LOCAL_LEGACY_WORDPRESS_PORT=127.0.0.1:8080
