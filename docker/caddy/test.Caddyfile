(test_headers) {
    header {
        X-Robots-Tag "noindex, nofollow, noarchive"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "SAMEORIGIN"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    }
    @xmlrpc path /xmlrpc.php
    respond @xmlrpc "XML-RPC is disabled." 403
}

teszt.appleklinika.com {
    encode zstd gzip
    import test_headers
    reverse_proxy wordpress:80
}

backoffice-teszt.appleklinika.com {
    encode zstd gzip
    import test_headers
    @backoffice path / /backoffice /backoffice/ /backoffice/*
    uri @backoffice query appleklinika_backoffice 1
    reverse_proxy wordpress:80
}
