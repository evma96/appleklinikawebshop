# PREPARATION ONLY. Never install/enable without separate production approval.
# Copy outside Git as a root-owned 0600 file. No credentials in this template.
export AK_BACKUP_ENABLED=no
export AK_ENVIRONMENT=PRODUCTION
export AK_EXPECTED_HOSTNAME=CHANGE_ME
export AK_SITE_HOST=CHANGE_ME
export AK_REPO_DIR=/CHANGE_ME/application-repo
export AK_BACKUP_ROOT=/CHANGE_ME/encrypted-backups
export AK_STATE_DIR=/CHANGE_ME/private-state
export AK_LOCK_FILE=/run/lock/appleklinika-approved-backup.lock
export AK_RECIPIENT_CERT=/CHANGE_ME/recovery-public-cert.pem
export AK_ARCHIVE_PATHS_FILE=/CHANGE_ME/backup-paths.txt
export AK_RETENTION_SETS=14
export AK_WORDPRESS_CONTAINER=CHANGE_ME
export AK_DATABASE_CONTAINER=CHANGE_ME
export AK_PROXY_CONTAINER=CHANGE_ME
export AK_DB_NAME=CHANGE_ME
export AK_DB_SECRET_FILE=/run/secrets/CHANGE_ME
