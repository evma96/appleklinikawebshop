{
  "enabled": false,
  "protocol": "sftp",
  "port": 22,
  "environment": "TEST",
  "expected_hostname": "appleklinika-staging-01",
  "host": "STORAGEBOX_HOST",
  "username": "STORAGEBOX_USER",
  "directory": "STORAGEBOX_REMOTE_PATH",
  "identity_file": "/etc/appleklinika-ops/storagebox-upload",
  "known_hosts": "/etc/appleklinika-ops/storagebox-known-hosts",
  "backup_root": "/opt/appleklinika/backups/routine",
  "state_file": "/var/lib/appleklinika-ops/offserver.json",
  "retention_sets": 30
}
