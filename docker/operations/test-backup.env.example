# Install as /etc/appleklinika-ops/backup.env (root 0600). TEST only.
export AK_ENVIRONMENT=TEST
export AK_SITE_HOST=teszt.appleklinika.com
export AK_COMPOSE_DIR=/opt/appleklinika/production
export AK_BACKUP_ROOT=/opt/appleklinika/backups/routine
export AK_STATE_DIR=/var/lib/appleklinika-ops
export AK_RECIPIENT_CERT=/etc/appleklinika-ops/recovery-cert.pem
export AK_RETENTION_SETS=14
export AK_WORDPRESS_CONTAINER=appleklinika-staging-wordpress-1
export AK_DATABASE_CONTAINER=appleklinika-staging-mariadb-1
export AK_PROXY_CONTAINER=appleklinika-staging-caddy-1
