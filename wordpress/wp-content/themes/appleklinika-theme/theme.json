{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1120px",
      "wideSize": "1240px"
    },
    "color": {
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "ink", "color": "#151b24", "name": "Ink" },
        { "slug": "muted", "color": "#667085", "name": "Muted" },
        { "slug": "line", "color": "#e3e8ef", "name": "Line" },
        { "slug": "brand", "color": "#c9152d", "name": "Brand" },
        { "slug": "blue", "color": "#286ff0", "name": "Blue" },
        { "slug": "green", "color": "#35bd68", "name": "Green" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#151b24"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "lineHeight": "1.45"
    }
  }
}
